  "criteria": [
    {
      "id": "AC1",
      "description": "Durable round trip: the compiled specification is fully saved to real SQLite and restored after close/reopen (objective, acceptance criteria, AC IDs + order, non-goals, assumptions, constraints, risk, complexity, proposed scope, visual requirements, version, lock state, provenance/timestamps).",
      "mandatory": true
    },
    {
      "id": "AC2",
      "description": "Stable acceptance criterion IDs: AC IDs remain stable after save/load, restart, idempotent re-save, and within a saved version; duplicate AC IDs are rejected by validation/schema.",
      "mandatory": true
    },
    {
      "id": "AC3",
      "description": "Locked version immutability: a locked version cannot be mutated silently or concurrently (objective, any list, AC, AC ID, risk/complexity, visual requirements); lock provenance is preserved; a new version is still allowed.",
      "mandatory": true
    },
    {
      "id": "AC4",
      "description": "Migration compatibility: migration v8 is additive, forward-only, idempotent, safe for an existing v7 DB, correct for a new empty DB, applied by the production daemon startup path, repeatable on stop/start, and cannot record a false schema version on a failed transaction.",
      "mandatory": true
    },
    {
      "id": "AC5",
      "description": "Atomic version allocation: version allocation is safe under concurrency (no duplicate versions, no lost updates, multiple goroutines and store instances on the same DB, no reliance on a process-local mutex, rollback semantics, correct sequence initialisation relative to existing max version).",
      "mandatory": true
    },
    {
      "id": "AC6",
      "description": "Storage and audit consistency: audit is recorded for successful mutations, rejected operations do not create a misleading successful audit event, a rolled-back storage mutation does not appear committed, an audit failure does not leave an inconsistent storage result (shared transaction), and current audit-architecture limitations are honestly documented.",
      "mandatory": true
    }
  ],
