  "criteria": [
    {
      "id": "AC1",
      "description": "The compiler deterministically produces a complete, valid Specification for typical tasks (bugfix, feature, UI, auth/security/payment) with all applicable fields (objective, acceptance criteria, non-goals, assumptions, constraints, risk, complexity, proposed scope, visual requirements).",
      "mandatory": true
    },
    {
      "id": "AC2",
      "description": "Unsafe ambiguity is explicitly flagged: vague/attachment-only input gets Confidence=LOW + a clarification; high-risk (security/auth/payment) tasks surface a clarification even with structured sections; no fabricated requirements; safe fallback for attachment-only input.",
      "mandatory": true
    },
    {
      "id": "AC3",
      "description": "Identical input produces identical output: the compiler is pure; CLI output is deterministic across repeated runs with fixed ComplexityReasons, acceptance-criteria, and list ordering (no test-only sorting).",
      "mandatory": true
    },
    {
      "id": "AC4",
      "description": "The compiler never mutates a locked specification: it returns Version=0/Locked=false, has no storage handle by construction, and the production storage layer rejects mutation of a locked version (compile -> save -> lock -> compile+save leaves the locked version byte-identical and allocates a new version).",
      "mandatory": true
    },
    {
      "id": "AC5",
      "description": "CLI production path: forge spec compile is registered in the dispatcher, help is available, default output is text, --json emits valid JSON, invalid priority/malformed attachment size/unknown role exit non-zero, attachment-only and legacy grammar work, output is deterministic, and validation failure does not persist partial durable state.",
      "mandatory": true
    },
    {
      "id": "AC6",
      "description": "All remediation findings (MAJOR-1, MINOR-1..5) are closed and each guarded by a named regression test; MINOR-6 is accepted as a non-blocking follow-up (FU-M14-02-9).",
      "mandatory": true
    }
  ],
